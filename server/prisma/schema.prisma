// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User roles
enum Role {
  ADMIN
  BARBER
}

// User levels
enum Level {
  JUNIOR
  SENIOR
  MASTER
  DIRECTOR
}

// User Model
model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      Role     @default(BARBER)
  name      String?
  phone     String?
  photoUrl  String?
  isActive  Boolean  @default(true)
  level     Level    @default(SENIOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Notification sound preference
  notificationSoundUrl  String?
  notificationSoundName String?

  appointments Appointment[]
}

// Service Category Enum
enum ServiceCategory {
  BARBERING
  GROOMING
  TREATMENTS
}

// Service Model
model Service {
  id          String           @id @default(uuid())
  name        String
  description String?
  price       Float
  duration    Int
  category    ServiceCategory  @default(BARBERING)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// Settings Model
model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Appointment Model
model Appointment {
  id             String   @id @default(uuid())
  name           String
  phone          String
  service        String
  time           DateTime
  status         String   @default("pending")
  notes          String?
  customDuration Int?
  trackingCode   String?  @unique
  deviceToken    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  barberId String
  barber   User @relation(fields: [barberId], references: [id], onDelete: Cascade)
}
