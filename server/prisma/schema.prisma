// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User Roles Enum
enum Role {
  ADMIN
  BARBER
}

// User Model - Tüm kullanıcılar (Admin ve Berberler)
model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String   // bcrypt hash
  role      Role     @default(BARBER)
  name      String?  // Berberin görünen adı (opsiyonel)
  phone     String?  // Berberin telefonu (opsiyonel)
  photoUrl  String?  // Berberin fotoğraf URL'si (opsiyonel)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // İlişkiler
  appointments Appointment[]
}

// Service Category Enum
enum ServiceCategory {
  BARBERING
  GROOMING
  TREATMENTS
}

// Service Model - Hizmetler
model Service {
  id          String           @id @default(uuid())
  name        String
  description String?
  price       Float
  duration    Int              // dakika cinsinden
  category    ServiceCategory  @default(BARBERING)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// Settings Model - Salon Ayarları
model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Appointment Model - Randevular
model Appointment {
  id           String   @id @default(uuid())
  name         String
  phone        String
  service      String
  time         DateTime
  status       String   @default("pending") // pending, approved, rejected
  notes        String?  // Ek notlar
  trackingCode String?  @unique
  deviceToken  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Hangi berberden alındığı
  barberId     String
  barber       User     @relation(fields: [barberId], references: [id], onDelete: Cascade)
}
