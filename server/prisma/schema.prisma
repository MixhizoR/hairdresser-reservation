generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    String        @id @default(uuid())
  username              String        @unique
  password              String
  role                  Role          @default("BARBER")
  name                  String?
  phone                 String?
  photoUrl              String?
  isActive              Boolean       @default(true)
  level                 Level         @default("SENIOR")
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  notificationSoundUrl  String?
  notificationSoundName String?
  appointments          Appointment[]
}

model Service {
  id          String          @id @default(uuid())
  name        String
  description String?
  price       Float
  duration    Int
  category    ServiceCategory @default("BARBERING")
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Appointment {
  id           String   @id @default(uuid())
  name         String
  phone        String
  service      String
  time         DateTime
  status       String   @default("pending")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  barberId     String
  deviceToken  String?
  trackingCode String?  @unique
  barber       User     @relation(fields: [barberId], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  BARBER
}

enum Level {
  JUNIOR
  SENIOR
  MASTER
}

enum ServiceCategory {
  BARBERING
  GROOMING
  TREATMENTS
}
